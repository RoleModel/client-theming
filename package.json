{
  "name": "@rolemodel/client-theming",
  "version": "0.1.4",
  "description": "Portable per-client branding: Brandfetch integration, brand registry, and contrast-aware MUI theme generation.",
  "keywords": [
    "brandfetch",
    "branding",
    "design-system",
    "mui",
    "multi-tenant",
    "theme",
    "white-label"
  ],
  "homepage": "https://github.com/RoleModel/client-theming#readme",
  "bugs": {
    "url": "https://github.com/RoleModel/client-theming/issues"
  },
  "license": "MIT",
  "author": "RoleModel Software",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RoleModel/client-theming.git"
  },
  "files": [
    "dist",
    "README.md",
    ".env.example"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./brand": {
      "types": "./dist/brand/index.d.ts",
      "import": "./dist/brand/index.js"
    },
    "./brandfetch": {
      "types": "./dist/brandfetch/index.d.ts",
      "import": "./dist/brandfetch/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    },
    "./logo": {
      "types": "./dist/logo/index.d.ts",
      "import": "./dist/logo/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:strict": "eslint src --max-warnings 0",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@mui/material": "^7",
    "@types/node": "^24",
    "@types/react": "^18.3.31",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^5"
  },
  "peerDependencies": {
    "@mui/material": ">=6",
    "react": ">=18",
    "react-dom": ">=18"
  }
}
